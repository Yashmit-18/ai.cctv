# ============================================================
# CCTV Employee Productivity Tracker -- Environment Variables
# ============================================================
# Copy this file to  .env  and fill in your values.
#
#   Windows PowerShell (from project root):
#     Copy-Item .env.example .env
#
# Lines starting with # are comments.  Kept deliberately free of
# secrets; all values below are either public test streams or
# dummy tokens.  Replace them before pointing at real hardware.
#
# Any CCTV_CAM_<NN>_URL that is left empty is automatically EXCLUDED
# from the camera pool, so you can enable 1-10 cameras freely.
# ============================================================

# ---------------------------------------------------------------------
# Multi-Camera RTSP feeds (Phase 7/8)
# ---------------------------------------------------------------------
# Format: rtsp://username:password@host:port/path
#
# TEST MODE: cams 01 & 02 use PUBLIC, always-on open test streams so you
# can verify `rtsp_tester.py` and the multi-threaded pool WITHOUT being
# physically at the client site.  They are public demo feeds; replace
# with real credentials when on-site.
#
# cam_01/cam_02 -> open public test streams (verified widely-used):
CCTV_CAM_01_URL=rtsp://rtspstream:2a12bd5@zephyr.rtsp.stream/pattern
CCTV_CAM_02_URL=rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mov

# cam_03..cam_10 -> placeholders for the client site. Leave the rest blank
# to disable those slots while testing.  Replace with real credentials on-site.
# NEVER commit real camera credentials to version control.
CCTV_CAM_03_URL=rtsp://user:CHANGE_ME@192.168.1.103:554/stream1
CCTV_CAM_04_URL=rtsp://user:CHANGE_ME@192.168.1.104:554/stream1
CCTV_CAM_05_URL=rtsp://user:CHANGE_ME@192.168.1.105:554/stream1
CCTV_CAM_06_URL=rtsp://user:CHANGE_ME@192.168.1.106:554/stream1
CCTV_CAM_07_URL=rtsp://user:CHANGE_ME@192.168.1.107:554/stream1
CCTV_CAM_08_URL=rtsp://user:CHANGE_ME@192.168.1.108:554/stream1
CCTV_CAM_09_URL=rtsp://user:CHANGE_ME@192.168.1.109:554/stream1
CCTV_CAM_10_URL=rtsp://user:CHANGE_ME@192.168.1.110:554/stream1

# --- Inference / capture tuning (optional) -------------------------
# Max frames per GPU batch (limits VRAM). Default 4.
# CCTV_MAX_BATCH_SIZE=4
# Target frames-per-second per camera. Default 2.
# CCTV_TARGET_FPS=2

# ============================================================
# Webcam / CPU development path (recommended daily driver)
# ============================================================
# --source webcam|0  opens local device 0 (see README). These tune that path:
# Startup probe timeout (s) for a local source; webcams can take
# several seconds to open. Default 15. Raise if you use a slow device.
# CCTV_STARTUP_FRAME_WAIT=15
# Max age (s) a frame may have before it is treated as stale and dropped,
# so a dead camera cannot keep the pipeline "online". Default 10.
# CCTV_FRAME_STALE_SEC=10
# Webcam frames are downscaled to this side length before face
# detection (smaller = faster on CPU). Default 640.
# CCTV_FACE_DETECT_SIZE=640

# ============================================================
# Working window / productivity (Phase 2B)
# ============================================================
# Expected working hours (local 24h). Lunch is treated as an unpaid
# (excluded) window; camera downtime is never charged to employees.
# CCTV_WORK_START=09:00
# CCTV_WORK_END=18:00
# Tolerance for lateness (minutes) -- informational in current reports.
# CCTV_GRACE_MIN=15
# CCTV_LUNCH=12:00-13:00
# Paid break allowance in minutes (informational).
# CCTV_BREAKS_MIN=30

# ============================================================
# Dashboard (Phases 9/10/11)
# ============================================================
# Auto-refresh interval in seconds (2/5/10/30 ...). Default 5.
# CCTV_DASH_REFRESH=5
# Dashboard authentication.  Set CCTV_DASH_AUTH=1 and at least one
# password to enable.  When no password is configured the dashboard
# runs open (admin).  NEVER hardcode these in the repo.
# CCTV_DASH_AUTH=1
# CCTV_DASH_USER=admin
# CCTV_DASH_PASS=replace-with-admin-password
# CCTV_DASH_VIEWER_PASS=replace-with-viewer-password

# ============================================================
# Email retry (Phase 13)
# ============================================================
# Bounded retries -- the daemon never loops forever.
# CCTV_EMAIL_RETRIES=3
# CCTV_EMAIL_RETRY_DELAY=10
# CCTV_EMAIL_TIMEOUT=30

# ============================================================
# Data retention (Phase 20) -- opt-in
# ============================================================
# The daemon NEVER deletes automatically unless enabled:
# CCTV_ENABLE_RETENTION=0
# Retention (days): keep daily analytics for 1 year by default.
# CCTV_RETENTION_DAYS=365
# CCTV_RETENTION_LOGS_DAYS=365
# CCTV_RETENTION_REPORTS_DAYS=365

# ============================================================
# Legacy single-stream source (can be removed once the multi-
# camera pool is fully wired). Kept for CLI fallback only.
# ============================================================
# webcam | video_file | rtsp
CCTV_SOURCE=webcam
CCTV_RTSP_URL=rtsp://user:CHANGE_ME@192.168.1.100:554/stream1

# ============================================================
# SMTP / Email  (dummy placeholders -- replace with real creds)
# ============================================================
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
# Use an app-password / OAuth token, never a plain account password.
SENDER_EMAIL=tracker@example.com
SENDER_PASSWORD=replace-with-app-password

# Comma-separated list of report recipients
RECIPIENT_EMAILS=manager@example.com,lead@example.com
